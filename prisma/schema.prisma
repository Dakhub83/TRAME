// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Contact form submissions
// ---------------------------------------------------------------------------

enum ContactStatus {
  NEW
  IN_REVIEW
  RESOLVED
}

model ContactSubmission {
  id        String        @id @default(cuid())
  fullName  String        @map("full_name")
  email     String
  // Local Burkina Faso (XOF) phone format, e.g. "+226 70 12 34 56" or
  // "70123456". Stored as free-form text; format is validated at the API
  // boundary (Zod), not enforced by a DB constraint.
  phone     String
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([status])
  @@index([createdAt])
  @@map("contact_submissions")
}

// ---------------------------------------------------------------------------
// Reservations
// ---------------------------------------------------------------------------

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

// Mirrors the app's supported UI locales (src/lib/i18n.ts: en, fr).
enum Locale {
  en
  fr
}

model Reservation {
  id               String        @id @default(cuid())
  passengerName    String        @map("passenger_name")
  phone            String
  // e.g. "1A", "14B" — matches the seat-map's seat id format.
  seatNumber       String        @map("seat_number")
  // Date-only precision: the calendar day of travel, not a timestamp.
  travelDate       DateTime      @map("travel_date") @db.Date
  corridorId       String        @map("corridor_id")
  corridor         Corridor      @relation(fields: [corridorId], references: [id], onDelete: Restrict)
  paymentStatus    PaymentStatus @default(PENDING) @map("payment_status")
  selectedLanguage Locale        @default(fr) @map("selected_language")
  createdAt        DateTime      @default(now()) @map("created_at")

  // Prevents two reservations from double-booking the same physical seat
  // on the same corridor and travel date.
  @@unique([corridorId, travelDate, seatNumber])
  @@index([travelDate])
  @@index([paymentStatus])
  @@map("reservations")
}

// ---------------------------------------------------------------------------
// Corridors (routes)
// ---------------------------------------------------------------------------

model Corridor {
  id                  String        @id @default(cuid())
  // e.g. "Ouagadougou - Bobo-Dioulasso"
  name                String        @unique
  basePriceCFA        Int           @map("base_price_cfa")
  travelDurationHours Float         @map("travel_duration_hours")
  isActive            Boolean       @default(true) @map("is_active")
  reservations        Reservation[]

  @@index([isActive])
  @@map("corridors")
}

// ---------------------------------------------------------------------------
// Account auth (email + password)
//
// A second, independent identity track alongside the phone/email one-time-
// code sessions in src/lib/client-auth.ts (in-memory, no DB row at all).
// The two aren't unified: an OTP session is just a cookie holding a phone
// or email string, while a User row here is a real account with a
// password. Both set the same session cookie (CLIENT_SESSION_COOKIE), so
// the rest of the app treats a logged-in visitor uniformly regardless of
// which path they used — but only a real User row has loyalty points,
// a role, or a created_at. Reconciling OTP identities into real User rows
// (and linking User to Passenger, from the manifest schema above, for real
// booking history) is a further follow-up, not done here.
// ---------------------------------------------------------------------------

enum UserRole {
  CLIENT
  DISPATCHER
  ADMIN
}

enum LoyaltyTier {
  STANDARD
  PRIVILEGE
  ELITE
}

model User {
  id             String          @id @default(cuid()) @map("user_id")
  email          String          @unique
  passwordHash   String          @map("password_hash")
  fullName       String          @map("full_name")
  phoneNumber    String?         @map("phone_number")
  role           UserRole        @default(CLIENT) @map("user_role")
  createdAt      DateTime        @default(now()) @map("created_at")
  loyaltyAccount LoyaltyAccount?

  @@index([role])
  @@map("users")
}

model LoyaltyAccount {
  id                String      @id @default(cuid()) @map("loyalty_id")
  userId            String      @unique @map("user_id")
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Points track kilometers traveled — e.g. one Ouagadougou-Bobo-Dioulasso
  // one-way trip (~360km) earns roughly 360 points.
  accumulatedPoints Int         @default(0) @map("accumulated_points")
  tierStatus        LoyaltyTier @default(STANDARD) @map("tier_status")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  @@map("loyalty_accounts")
}

// ---------------------------------------------------------------------------
// Passenger manifest (dispatch/gate operations)
//
// Distinct from Reservation/Corridor above, which model the public booking
// checkout flow. This side models a specific scheduled vehicle departure
// (Trip) and the gate-facing manifest of who's actually on it — ticket
// codes, seat assignments, luggage, boarding status. The two aren't linked
// yet (Reservation has no tripId); reconciling them into one booking model
// is a real follow-up, not done here since Reservation is already wired to
// the live /book flow.
// ---------------------------------------------------------------------------

enum TripStatus {
  SCHEDULED
  BOARDING
  DEPARTED
  ARRIVED
  CANCELLED
}

enum BoardingStatus {
  RESERVED
  CHECKED_IN
  BOARDED
  NO_SHOW
}

model Trip {
  id                 String               @id @default(cuid()) @map("trip_id")
  // e.g. "OUAGA-BOBO-01" — matches src/lib/dispatch.ts's routeCode values.
  routeCode          String               @map("route_code")
  // e.g. "yutong-t12" — the fleet vehicle running this specific departure.
  vehicleId          String               @map("vehicle_id")
  departureTimestamp DateTime             @map("departure_timestamp")
  // e.g. "Quai 3" — the physical gate passengers board from. Nullable: not
  // assigned until close to departure.
  departureGate      String?              @map("departure_gate")
  status             TripStatus           @default(SCHEDULED) @map("trip_status")
  bookings           ManifestBooking[]
  operatingCosts     RouteOperatingCost[]
  createdAt          DateTime             @default(now()) @map("created_at")

  @@index([departureTimestamp])
  @@index([routeCode])
  @@index([departureGate])
  @@map("trips")
}

model Passenger {
  id                  String            @id @default(cuid()) @map("passenger_id")
  fullName            String            @map("full_name")
  phoneNumber         String            @map("phone_number")
  // e.g. a national ID or passport number. Free-form and optional — not
  // every corridor requires one; validated at the API boundary, not here,
  // same convention as ContactSubmission.phone above.
  identityDocumentRef String?           @map("identity_document_ref")
  bookings            ManifestBooking[]
  createdAt           DateTime          @default(now()) @map("created_at")

  @@index([phoneNumber])
  @@map("passengers")
}

model ManifestBooking {
  id                 String                 @id @default(cuid()) @map("booking_id")
  tripId             String                 @map("trip_id")
  trip               Trip                   @relation(fields: [tripId], references: [id], onDelete: Restrict)
  passengerId        String                 @map("passenger_id")
  passenger          Passenger              @relation(fields: [passengerId], references: [id], onDelete: Restrict)
  // e.g. "TR-4471" — shown to the passenger and looked up on the public
  // tracker page (src/lib/tracking.ts).
  ticketCode         String                 @unique @map("ticket_code")
  // Capped at the vehicle's real seat count (see src/lib/fleet.ts) — that
  // cap is enforced at the API boundary (Zod), not as a DB constraint, same
  // convention as the free-form phone fields above.
  assignedSeatNumber Int                    @map("assigned_seat_number")
  luggageWeightKg    Float                  @default(0) @map("luggage_weight_kg")
  boardingStatus     BoardingStatus         @default(RESERVED) @map("boarding_status")
  createdAt          DateTime               @default(now()) @map("created_at")
  transactions       FinancialTransaction[]

  // One seat, one passenger, per trip.
  @@unique([tripId, assignedSeatNumber])
  @@index([tripId])
  @@index([passengerId])
  @@index([boardingStatus])
  @@map("manifest_bookings")
}

// ---------------------------------------------------------------------------
// Finance (revenue + operating costs)
//
// amounts are plain Int FCFA, same convention as Corridor.basePriceCFA above
// — the franc CFA has no subunit in everyday use, so there's no need for
// Decimal here.
// ---------------------------------------------------------------------------

enum PaymentMethod {
  ORANGE_MONEY
  MOOV_MONEY
  CASH
  CARD
}

model FinancialTransaction {
  id                String          @id @default(cuid()) @map("transaction_id")
  bookingId         String          @map("booking_id")
  booking           ManifestBooking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  amountFcfa        Int             @map("amount_fcfa")
  paymentMethod     PaymentMethod   @map("payment_method")
  processingFeeFcfa Int             @default(0) @map("processing_fee_fcfa")
  settledAt         DateTime?       @map("settled_at")
  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([bookingId])
  @@index([paymentMethod])
  @@index([settledAt])
  @@map("financial_transactions")
}

model RouteOperatingCost {
  id               String   @id @default(cuid()) @map("cost_id")
  tripId           String   @map("trip_id")
  trip             Trip     @relation(fields: [tripId], references: [id], onDelete: Restrict)
  fuelExpenseFcfa  Int      @map("fuel_expense_fcfa")
  tollFeesFcfa     Int      @default(0) @map("toll_fees_fcfa")
  driverPayoutFcfa Int      @map("driver_payout_fcfa")
  loggedTimestamp  DateTime @default(now()) @map("logged_timestamp")

  @@index([tripId])
  @@map("route_operating_costs")
}
